---
import BaseLayout from '../layouts/BaseLayout.astro';
import IndexRow from '../components/IndexRow.astro';
import { allMilestones, recordPath } from '../lib/content';
import { STATUS_TONE, HORIZON_LABEL, label as lbl } from '../lib/taxonomy';

const milestones = await allMilestones();
const horizons = ['now', 'next', 'later'] as const;
const forward = (h: string) => milestones.filter((m) => m.data.horizon === h);
const shipped = milestones
  .filter((m) => m.data.horizon === 'shipped')
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));
---

<BaseLayout
  title="Roadmap"
  description="Where Windchime, Lichtspiel, and HRNSXTN x RDMSXN are headed: a combined Now / Next / Later view, plus what already shipped."
>
  <section class="container wrap">
    <p class="label"><span class="idx">§</span> Roadmap</p>
    <h1>Now · Next · Later.</h1>
    <p class="lead measure">
      Every project on one horizon. Forward looking work is grouped by how soon it's likely to land;
      delivered work is separated out below so the plan never masquerades as done.
    </p>

    {
      horizons.map((h) => (
        <div class="hgroup">
          <p class="label hgroup-h">{HORIZON_LABEL[h]}</p>
          <div class="rows">
            {forward(h).map((m) => (
              <IndexRow
                href={recordPath('milestone', m.data.product, m.id)}
                tone={STATUS_TONE[m.data.status] ?? 'neutral'}
                badge={lbl(m.data.status)}
                title={m.data.title}
                product={m.data.product}
                meta={m.data.confidence && `confidence: ${m.data.confidence}`}
              />
            ))}
            {forward(h).length === 0 && <p class="hempty">None yet.</p>}
          </div>
        </div>
      ))
    }

    <div class="hgroup shipped">
      <p class="label hgroup-h"><span class="idx">✓</span> Shipped</p>
      <div class="rows">
        {
          shipped.map((m) => (
            <IndexRow
              href={recordPath('milestone', m.data.product, m.id)}
              title={m.data.title}
              product={m.data.product}
              date={m.data.date}
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .wrap {
    padding-block: var(--sp-8) var(--sp-9);
  }
  h1 {
    margin-top: var(--sp-4);
  }
  .lead {
    margin-top: var(--sp-4);
    font-size: var(--step-1);
    color: var(--ink-soft);
  }
  .hgroup {
    margin-top: var(--sp-7);
  }
  .hgroup-h {
    padding-bottom: var(--sp-2);
    border-bottom: 2px solid var(--brand);
  }
  .rows {
    margin-top: var(--sp-4);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }
  .hempty {
    color: var(--faint);
    font-family: var(--font-mono);
  }
  .shipped {
    margin-top: var(--sp-8);
  }
</style>
