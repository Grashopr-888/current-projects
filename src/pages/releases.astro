---
import BaseLayout from '../layouts/BaseLayout.astro';
import IndexRow from '../components/IndexRow.astro';
import FilteredList from '../components/FilteredList.astro';
import Section from '../components/Section.astro';
import IncidentsIndex from '../components/IncidentsIndex.astro';
import HowIWork from '../components/HowIWork.astro';
import { allReleases, allIncidents, recordPath } from '../lib/content';
import { STATUS_TONE, label as lbl } from '../lib/taxonomy';

const releases = await allReleases();
const shipped = releases.filter((r) => r.data.status === 'shipped').length;
const incidentCount = (await allIncidents()).length;
---

<BaseLayout
  title="Releases"
  description="What shipped across Windchime, HRNSXTN x RDMSXN, Lichtspiel and Probing the World for Groove, the incidents behind it, and the way of working that ties them together."
>
  <section class="container wrap">
    <p class="label"><span class="idx">§</span> Releases</p>
    <h1>What shipped, and why it mattered.</h1>
    <p class="lead measure">
      A reverse chronological changelog across the projects. Each entry is framed by the value it
      delivered and the risk it carried, not the diff behind it.
    </p>
    <p class="also">
      Also here: <a class="plain" href="#incidents">Incidents</a> ·
      <a class="plain" href="#how-i-work">How I work</a>
    </p>

    <FilteredList
      label="Filter releases by project"
      products={['windchime', 'hrnsxtn', 'lichtspiel', 'groove']}
      count={`${shipped} shipped · ${releases.length} total`}
    >
      {
        releases.map((r) => (
          <IndexRow
            href={recordPath('release', r.data.product, r.id)}
            tone={STATUS_TONE[r.data.status] ?? 'neutral'}
            badge={lbl(r.data.status)}
            title={r.data.title}
            product={r.data.product}
            date={r.data.date}
          />
        ))
      }
    </FilteredList>

    <div class="more-areas">
      <Section
        label="Incidents"
        title="Bugs, and what they taught"
        id="incidents"
        collapsible
        count={incidentCount}
      >
        <p class="area-lead measure">
          Blameless postmortems across the products: impact, root cause, fix, and the follow
          through.
        </p>
        <IncidentsIndex />
      </Section>

      <Section
        label="How I work"
        title="How I build, start to finish"
        id="how-i-work"
        collapsible
        meta="Loop, pipeline, cadence, templates"
      >
        <p class="area-lead measure">
          The operating system behind the products: the cadence behind the work, and the artifacts
          you can lift and use.
        </p>
        <HowIWork />
      </Section>
    </div>
  </section>
</BaseLayout>

<style>
  .wrap {
    padding-block: var(--sp-8) var(--sp-9);
  }
  h1 {
    margin-top: var(--sp-4);
  }
  .lead {
    margin-top: var(--sp-4);
    font-size: var(--step-1);
    color: var(--ink-soft);
  }
  .also {
    margin-top: var(--sp-3);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--muted);
  }
  .also a {
    color: var(--brand);
  }
  .also a:hover {
    text-decoration: underline;
  }
  .more-areas {
    margin-top: var(--sp-8);
  }
  .area-lead {
    color: var(--ink-soft);
  }
</style>
