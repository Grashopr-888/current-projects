---
import BaseLayout from '../layouts/BaseLayout.astro';
import IndexRow from '../components/IndexRow.astro';
import { allReleases, recordPath } from '../lib/content';
import { STATUS_TONE, label as lbl } from '../lib/taxonomy';

const releases = await allReleases();
const shipped = releases.filter((r) => r.data.status === 'shipped').length;
---

<BaseLayout
  title="Releases"
  description="What shipped across Windchime, Lichtspiel, and HRNSXTN x RDMSXN, when, and why it mattered."
>
  <section class="container wrap">
    <p class="label"><span class="idx">§</span> Releases</p>
    <h1>What shipped, and why it mattered.</h1>
    <p class="lead measure">
      A reverse chronological changelog across all three products. Each entry is framed by the value
      it delivered and the risk it carried, not the diff behind it.
    </p>

    <div class="toolbar">
      <div class="filterbar" role="group" aria-label="Filter by product">
        <button class="filter-btn" data-filter="all" aria-pressed="true">All</button>
        <button class="filter-btn" data-filter="windchime" aria-pressed="false">Windchime</button>
        <button class="filter-btn" data-filter="lichtspiel" aria-pressed="false">Lichtspiel</button>
        <button class="filter-btn" data-filter="hrnsxtn" aria-pressed="false"
          >HRNSXTN x RDMSXN</button
        >
      </div>
      <span class="count">{shipped} shipped · {releases.length} total</span>
    </div>

    <div class="list" id="release-list" data-active="all">
      {
        releases.map((r) => (
          <IndexRow
            href={recordPath('release', r.data.product, r.id)}
            tone={STATUS_TONE[r.data.status] ?? 'neutral'}
            badge={lbl(r.data.status)}
            title={r.data.title}
            product={r.data.product}
            date={r.data.date}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .wrap {
    padding-block: var(--sp-8) var(--sp-9);
  }
  h1 {
    margin-top: var(--sp-4);
  }
  .lead {
    margin-top: var(--sp-4);
    font-size: var(--step-1);
    color: var(--ink-soft);
  }
  .toolbar {
    margin-top: var(--sp-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }
  .filterbar {
    display: flex;
    gap: 0.3rem;
  }
  .filter-btn {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    padding: 0.4rem 0.8rem;
    border-radius: 100px;
    border: var(--hair) solid var(--hairline-strong);
    background: var(--surface);
    color: var(--muted);
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .filter-btn[aria-pressed='true'] {
    color: var(--bg);
    background: var(--ink);
    border-color: var(--ink);
  }
  .count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--faint);
  }
  .list {
    margin-top: var(--sp-4);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }
  .list[data-active='windchime'] :global(.irow[data-product='lichtspiel']),
  .list[data-active='windchime'] :global(.irow[data-product='hrnsxtn']),
  .list[data-active='lichtspiel'] :global(.irow[data-product='windchime']),
  .list[data-active='lichtspiel'] :global(.irow[data-product='hrnsxtn']),
  .list[data-active='hrnsxtn'] :global(.irow[data-product='windchime']),
  .list[data-active='hrnsxtn'] :global(.irow[data-product='lichtspiel']) {
    display: none;
  }
</style>

<script>
  const bar = document.querySelector('.filterbar');
  const list = document.getElementById('release-list');
  bar?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-filter]');
    if (!btn || !list) return;
    list.dataset.active = btn.dataset.filter;
    bar
      .querySelectorAll<HTMLElement>('[data-filter]')
      .forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
  });
</script>
