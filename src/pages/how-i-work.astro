---
import BaseLayout from '../layouts/BaseLayout.astro';
import HowIWork from '../components/HowIWork.astro';
---

<BaseLayout
  title="How I Work"
  description="The repeatable operating system behind all three products: the loop, the pipeline, the shipping cadence, and the templates."
>
  <section class="container wrap">
    <p class="label"><span class="idx">§</span> How I work</p>
    <h1>How I build, start to finish.</h1>
    <p class="lead measure">
      Windchime and Lichtspiel came out of the same loop and the same templates. This page is the
      operating system itself: the cadence behind the work, and the artifacts you can lift and use.
    </p>
    <HowIWork />
  </section>
</BaseLayout>

<style>
  .wrap {
    padding-block: var(--sp-8) var(--sp-9);
  }
  h1 {
    margin-top: var(--sp-4);
  }
  .lead {
    margin-top: var(--sp-4);
    font-size: var(--step-1);
    color: var(--ink-soft);
  }
</style>
