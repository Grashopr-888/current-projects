---
import BaseLayout from '../layouts/BaseLayout.astro';
import IndexRow from '../components/IndexRow.astro';
import { allResearch, recordPath } from '../lib/content';
import { label as lbl } from '../lib/taxonomy';

const notes = await allResearch();
---

<BaseLayout
  title="Research"
  description="How the thinking is tested: discovery, market scans, and the research process behind the work."
>
  <section class="container wrap">
    <p class="label"><span class="idx">§</span> Research</p>
    <h1>How the thinking is tested.</h1>
    <p class="lead measure">
      A sanitized archive of discovery, market scans, and experiments, including how product work
      turns into academic contribution. Where results are still under review, the method is shown
      and the findings are held back.
    </p>

    <div class="list">
      {
        notes.map((n) => (
          <IndexRow
            href={recordPath('research', n.data.product, n.id)}
            tone="info"
            badge={lbl(n.data.source_type)}
            title={n.data.title}
            product={n.data.product}
            meta={n.data.redaction_status !== 'clean' ? 'Process only' : undefined}
            date={n.data.date}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .wrap {
    padding-block: var(--sp-8) var(--sp-9);
  }
  h1 {
    margin-top: var(--sp-4);
  }
  .lead {
    margin-top: var(--sp-4);
    font-size: var(--step-1);
    color: var(--ink-soft);
  }
  .list {
    margin-top: var(--sp-7);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }
</style>
