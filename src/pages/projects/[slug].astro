/** Tool chips beside the credit line. The credit line itself is PROJECT_META.*.credit. */
const TOOLS: Record<Product, string[]> = {
  windchime: [
    'Audio language models (CLAP, CLaMP 3)',
    'faster-whisper ASR',
    'FAISS',
    'Python',
    'FastAPI',
    'Strudel',
    'p5.js',
    'Three.js',
    'monome',
  ],
  lichtspiel: [
    'TypeScript',
    'p5.js',
    'Vite',
    'Node WebSocket bridge',
    'Max for Live',
    'Ableton Live',
    'Python / FastAPI',
    'CLAP + librosa',
    'Claude (authoring time)',
    'monome',
  ],
  hrnsxtn: [
    'Elk Stomp',
    'Elk Audio OS / SUSHI',
    'C++ / JUCE 8',
    'RTNeural',
    'ARM NEON',
