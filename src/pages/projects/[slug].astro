/** The ML method each project chose, against what it weighed (skim layer). */
type Method = {
  title: string;
  lead: string;
  rows: MethodRow[];
  /** Short practice cards under the table: data, augmentation, robustness, evaluation. */
  practices?: Array<{ title: string; body: string }>;
};
const METHODS: Partial<Record<Product, Method>> = {
  windchime: {
    title: 'Zero shot retrieval and structured outputs',
    lead: 'Pretrained audio language models retrieve zero shot from a closed corpus, and the planner may only fill a validated schema, so the model under study stays a clean variable. As the corpus and its run log grow, finetuning becomes the next lever.',
    rows: [
      {
        option: 'Zero shot retrieval with pretrained ALMs',
        verdict: 'chosen',
        why: 'Contrastive pretraining already aligns text and audio. Six deployable configurations (CLAP family, CLaMP 3) swap behind one interface as a controlled variable, all on CPU, offline.',
      },
      {
        option: 'Structured output: an LLM fills a JSON schema',
        verdict: 'chosen',
        why: 'Claude, then a local Llama, then a deterministic template. A validator clamps every plan before a compiler renders the Strudel.',
      },
      {
        option: 'LLM bypass',
        verdict: 'chosen',
        why: 'The install default: CLaMP 3 retrieval plays the stems directly, in a fraction of a second.',
      },
      {
        option: 'Model writes Strudel code directly',
        verdict: 'rejected',
        why: 'Most expressive, but unbounded and impossible to validate before it plays.',
      },
      {
        option: 'SFT of the planner on logged runs',
        verdict: 'next',
        why: 'Every good generation is logged as a prompt and plan pair, a dataset that grows with each visitor: first as retrieved in context examples, then as SFT data.',
      },
      {
        option: 'Contrastive finetuning of an ALM',
        verdict: 'next',
        why: 'As the corpus grows beyond 406 stems, tuning an ALM on the artist’s audio and descriptions would sharpen retrieval toward this corpus.',
      },
      {
        option: 'Generative audio',
        verdict: 'rejected',
        why: 'Retrieval answers with the artist’s own recordings; generation would take authorship away from the artist.',
      },
    ],
    practices: [
      {
        title: 'Data engineering',
        body: 'Five corpus batches (203 to 406 stems), each a new index epoch; roles from validated mapping files; RMS levelling toward the corpus median; only rows embedded from silence are reembedded, per model.',
      },
      {
        title: 'Robustness',
        body: 'The audit scores paraphrase stability and cross language consistency, not only coverage. Plans are clamped by a validator, profanity is masked, and state changing endpoints check their Origin.',
      },
      {
        title: 'Evaluation without labels',
        body: 'With no ground truth, the audit measures behavior: catalog coverage, entropy, Gini and top 10 dominance over 80 prompts, 10 paraphrase groups and 5 languages. Results stay private under review.',
      },
    ],
  },
  hrnsxtn: {
    title: 'Knowledge distillation, a post training method, over compression',
    lead: 'Distillation trains a small student to reproduce a large pretrained teacher. It replaced the 58M parameter music2latent encoder at the input because shrinking the teacher itself could not close the gap.',
    rows: [
      {
        option: 'Distill the encoder into a student',
        verdict: 'chosen',
        why: 'Feature distillation: a 103k parameter MLP regresses the teacher’s 64 dim latent from one log mel frame (MSE plus a cosine term). 560× smaller, Spearman ρ .829 against the teacher’s ordering, about 1% of each 93 ms analysis on the pedal.',
      },
      {
        option: 'Post training quantization and pruning',
        verdict: 'rejected',
        why: 'Int8 buys 2 to 3 times; the pedal needed 30 to 100 times, and no PyTorch runtime exists for its 32 bit ARM.',
      },
      {
        option: 'Teacher on a laptop, streamed to the pedal',
        verdict: 'rejected',
        why: 'Breaks the brief (no laptop on stage) and makes venue wireless part of the instrument.',
      },
      {
        option: 'Ridge regression map',
        verdict: 'baseline',
        why: 'A linear map from the same input: ρ .797.',
      },
      {
        option: 'MFCC matching, no learning',
        verdict: 'baseline',
        why: 'ρ .575; its picks land in the teacher’s top 15 to 18%, the student’s in the top 4 to 7%.',
      },
      {
        option: 'Recurrent student (GRU)',
        verdict: 'compared',
        why: 'ρ .826, a tie with the MLP; the stateless model shipped, simpler on the worker thread.',
      },
      {
        option: 'Quantize or prune the student too',
        verdict: 'rejected',
        why: 'Not worth it at 1% of the budget. Only the matching table went to 8 bit: ρ 1.000, search 2.6 to 3.1 times faster.',
      },
      {
        option: 'An inference engine (ONNX, TFLite)',
        verdict: 'rejected',
        why: 'RTNeural runs the exported MLP from a JSON file in plain C++, no engine on the device.',
      },
      {
        option: 'An ordering term in the loss',
        verdict: 'next',
        why: 'Onsets are the weakest frames; training on rank directly is the next step.',
      },
    ],
  },
  lichtspiel: {
    title: 'An LLM at authoring time, a verifier on every output',
    lead: 'Claude writes each scene from a prompt and the set’s MIR features, and a five gate verifier decides what may play. The performance path never calls a model.',
    rows: [
      {
        option: 'Generate, verify, repair',
        verdict: 'chosen',
        why: 'Typecheck, allowlist lint, monome playability and a headless render smoke test, inside a bounded self repair loop. The first scene through passed every gate at 60 fps.',
      },
      {
        option: 'Call the model live, on the render path',
        verdict: 'rejected',
        why: 'Most responsive on paper; unpredictable latency, and it fails without a network.',
      },
      {
        option: 'Envelope mapping, the classic VJ approach',
        verdict: 'baseline',
        why: 'Follows loudness, not structure: it does not know the B section.',
      },
      {
        option: 'SFT or preference tuning on verified scenes',
        verdict: 'next',
        why: 'Every scene that passes the gates, and every one a performer keeps, is a labelled example; as the library grows, it can tune the generator itself.',
      },
    ],
  },
};

/** Research to production, one step each (skim layer). */
type Pipeline = {
  title: string;
  steps: Array<{ phase: string; label: string; note?: string }>;
  caption?: string;
};
const PIPELINES: Partial<Record<Product, Pipeline>> = {
  windchime: {
    title: 'From notebook to an unattended gallery',
    steps: [
      { phase: 'Design', label: 'Guarded planner', note: 'schema, failover, retrieval in process' },
      {
        phase: 'Research',
        label: 'ALM audit harness',
        note: 'six deployable models, one interface',
      },
      {
        phase: 'Data',
        label: 'Corpus engineering',
        note: '130 to 406 stems, levelled and reembedded',
      },
      { phase: 'Harden', label: '6 hour soak', note: '879 synthetic visitors, zero crashes' },
      { phase: 'Deploy', label: 'Gray Area debut', note: 'offline and unattended, Aug 5–7' },
      { phase: 'Publish', label: 'NeurIPS 2026', note: 'Creative AI poster, Sydney' },
    ],
  },
  hrnsxtn: {
    title: 'From a Python reference to a pedal, bit for bit',
    steps: [
      {
        phase: 'Research',
        label: 'Python reference',
        note: 'music2latent embeds each corpus offline',
      },
      { phase: 'Train', label: 'Distill the student', note: 'PyTorch, AdamW, early stopping' },
      { phase: 'Evaluate', label: 'Rank fidelity', note: 'ρ .829 on 12 held out queries' },
      { phase: 'Export', label: 'RTNeural JSON', note: 'byte exact round trip' },
      { phase: 'Port', label: 'C++ and JUCE', note: 'golden parity: 200 of 200 identical picks' },
      { phase: 'Deploy', label: 'On the Elk Stomp', note: 'Docker cross build for 32 bit ARM' },
      { phase: 'Publish', label: 'ISMIR 2026', note: 'paper, code and board logs public' },
    ],
  },
  lichtspiel: {
    title: 'From a hackathon fork to a stage instrument',
    steps: [
      { phase: 'Research', label: 'Not another VJ tool', note: 'what envelope mapping misses' },
      { phase: 'Prototype', label: 'Hackathon build', note: 'three forks at AIMS 2026' },
      { phase: 'Consolidate', label: 'One build', note: '43 commits in four days' },
      {
        phase: 'Validate',
        label: 'Five gate chain',
        note: 'every generated scene, before it plays',
      },
      { phase: 'Ship', label: 'Max for Live device', note: 'model free on stage' },
