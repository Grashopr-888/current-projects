---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import Disclosure from '../../components/Disclosure.astro';
import SpecSheet from '../../components/SpecSheet.astro';
import Badge from '../../components/Badge.astro';
import Timeline from '../../components/Timeline.astro';
import { projectBundle, toTimeline, type Product } from '../../lib/content';
import { STATUS_TONE, label as lbl } from '../../lib/taxonomy';
import { PROJECT_META } from '../../config';
import { url } from '../../lib/url';
import { fmtDay, readingTime } from '../../lib/format';
import FlowDiagram from '../../components/FlowDiagram.astro';
import Kanban from '../../components/Kanban.astro';
import MonomeTwin from '../../components/MonomeTwin.astro';
import LatentMap from '../../components/LatentMap.astro';
import { existsSync } from 'node:fs';

type Stage = { label: string; note?: string };
const DIAGRAMS: Record<Product, { stages: Stage[]; outputs: Stage[]; caption: string }> = {
  windchime: {
    stages: [
      { label: 'Voice', note: 'microphone' },
      { label: 'ASR', note: 'on device' },
      { label: 'Retrieval', note: 'ALM + FAISS' },
      { label: 'Guarded planner', note: 'fills a schema' },
    ],
    outputs: [
      { label: 'Live coded audio', note: 'Strudel' },
      { label: 'Generative visuals', note: 'p5 / Three.js' },
      { label: 'monome LEDs' },
    ],
    caption: 'One direction of flow: a spoken phrase becomes sound, light and hardware state.',
  },
  lichtspiel: {
    stages: [
      { label: 'Ableton Live', note: 'the set' },
      { label: 'Max for Live', note: 'thin shell' },
      { label: 'Node bridge', note: 'validate and route' },
    ],
    outputs: [
      { label: 'p5 runtime', note: 'renders on stage' },
      { label: 'ML service', note: 'authoring time only' },
      { label: 'monome grid + arc' },
    ],
    caption:
      'The live set drives visuals through a bridge. The model stays off the performance path.',
  },
  hrnsxtn: {
    stages: [
      { label: 'Corpus', note: 'a folder of recordings' },
      { label: 'music2latent', note: 'offline, on a laptop' },
      { label: 'Pack file', note: 'grains + embeddings' },
      { label: 'Live match', note: 'student MLP, 10.7 Hz' },
    ],
    outputs: [
      { label: 'Grain playback', note: 'real audio, 48 kHz' },
      { label: 'Knobs', note: 'Sensei / Guru' },
      { label: 'The answer', note: 'one bar later' },
    ],
    caption:
      'The heavy model runs once, offline. On the pedal, decisions happen at 10.7 Hz and the audio thread only plays real recordings.',
  },
};
/** Caption for the stylized monome twin, per project. */
const HARDWARE: Record<Product, string> = {
  windchime:
    'A monome Grid and Arc, remapped per scene over serialosc, steer visuals only; an ' +
    'onscreen twin mirrors every LED.',
  lichtspiel:
    'The monome is the instrument: a capability adaptive mapping folds each sketch onto ' +
    'whatever hardware is plugged in, from a Grid 64 with an Arc 2 up to a Grid 128 with an ' +
    'Arc 4. The same onscreen twin keeps the piece fully playable with no hardware at all, ' +
    'which is also how it survives an unreliable stage.',
  hrnsxtn:
    'The Elk Stomp development board is the whole interface: eight pots, four endless ' +
    'encoders, four footswitches and a small OLED that the instrument deliberately ignores. ' +
    'Five shaping controls, grain size, wet and randomness map straight onto the pots, so ' +
    'the corpus is played by feel, the way the challenge asked.',
};

/** Image sections shown in the skim layer, so screenshots are never hidden in the story. */
type Figure = {
  src: string;
  alt: string;
  caption: string;
  link?: { label: string; href: string; after: string };
};
type Gallery = { label: string; title: string; lead?: string; figures: Figure[] };
const GALLERIES: Partial<Record<Product, { program?: Gallery; prototype?: Gallery }>> = {
  hrnsxtn: {
    program: {
      label: 'Recognition',
      title: 'On the official program',
      figures: [
        {
          src: '/img/hs-showcase-title.png',
          alt: 'MUTEK Forum page header for the Music Hackspace x MUTEK Hackathon Winners Showcase',
          caption: "The festival's official ",
          link: {
            label: 'Winners Showcase listing',
            href: 'https://forum.mutek.org/en/shows/2026/music-hackspace-x-mutek-hackathon-winners-showcase',
            after: ': MUTEK Forum, August 28, Grands Ballets.',
          },
        },
        {
          src: '/img/hs-showcase-winners.png',
          alt: "The winners list from MUTEK's page, naming HRNSXTN x RDMSXN for the Elk Audio challenge: Dennison Blackett, Radu-Alex Ceban, Jazz Calls Home, and Trent Eriksen",
          caption:
            'The winners presenting on stage, as published by MUTEK: HRNSXTN x RDMSXN for the Elk Audio challenge.',
        },
      ],
    },
    prototype: {
      label: 'The prototype',
      title: 'Three faces, on screen',
      lead: 'Built and gated on a laptop the week before the hackathon, before it met the pedal.',
      figures: [
        {
          src: '/img/hs-ui-studio.jpg',
          alt: "The granular instrument's studio view: two voice panels with shaping controls flanking a 3D latent map of 16,945 grains from 38 files",
          caption:
            "Studio: two voices over one map of 16,945 grains from 38 files. Five shaping controls, grain size, blend and gain match sit where the pedal's eight pots now read them.",
        },
        {
          src: '/img/hs-ui-stage.jpg',
          alt: "The stage view: a dark performance theme where both voices' cursors traverse the latent point cloud",
          caption:
            'Stage: the performance theme. Cursors A and B are the two voices moving through the corpus live; everything else recedes.',
        },
        {
          src: '/img/hs-ui-setup.jpg',
          alt: 'The setup panel: an Ableton routing checklist, block and buffer status, saved presets, and the corpus builder for sound worlds',
          caption:
            'Setup: routing checklist, block and buffer health, presets, and the corpus builder that turns a folder of recordings into a sound world.',
        },
      ],
    },
  },
};

/** Where a project has been shown or accepted, as cards (skim layer). */
type Venue = {
  name: string;
  place: string;
  detail: string;
  logo?: { src: string; alt: string };
  paper?: { title: string; summary: string };
  link?: { label: string; href: string };
};
const VENUES: Partial<Record<Product, { label: string; title: string; venues: Venue[] }>> = {
  windchime: {
    label: 'Recognition',
    title: 'San Francisco, then Sydney',
    venues: [
      {
        name: 'Gray Area',
        place: 'San Francisco, USA · Aug 5–7, 2026',
        detail: 'Debuted at the Gray Area Cultural Incubator Showcase.',
        logo: { src: '/img/logo-grayarea.svg', alt: 'Gray Area' },
      },
      {
        name: 'NeurIPS 2026 · Creative AI Track',
        place: 'Sydney, Australia · December 2026',
        detail: 'Accepted artwork, under the track theme Agency.',
        paper: {
          title: 'Windchime: an Audiovisual Installation with Audio-Language Model implementations',
          summary:
            'It shows how agency splits three ways: the artist authors the corpus, the model shapes what is reachable, and the visitor’s speech drives each turn.',
        },
        logo: { src: '/img/logo-neurips.svg', alt: 'NeurIPS' },
        link: {
          label: 'Read it on OpenReview',
          href: 'https://openreview.net/forum?id=KKLTKVVHkM',
        },
      },
    ],
  },
};

/** Tool chips beside the credit line. The credit line itself is PROJECT_META.*.credit. */
const TOOLS: Record<Product, string[]> = {
  windchime: ['monome', 'Strudel', 'p5.js', 'Three.js'],
  lichtspiel: ['Ableton Live', 'Max for Live', 'monome'],
  hrnsxtn: ['Elk Stomp', 'JUCE', 'PyTorch', 'RTNeural'],
};

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const d = project.data;
const slug = project.id as Product;
const meta = PROJECT_META[slug];
const diagram = DIAGRAMS[slug];
const tools = TOOLS[slug];
const gallery = GALLERIES[slug] ?? {};
const venues = VENUES[slug];
const demoVideoId = 'demoVideoId' in meta ? meta.demoVideoId : undefined;
const demoVideoTitle = 'demoVideoTitle' in meta ? meta.demoVideoTitle : 'Project demo';

/* A secondary hero image (top right), where a project defines one. */
const aside = 'aside' in meta ? meta.aside : undefined;
const asideAlt = 'asideAlt' in meta ? meta.asideAlt : '';
const asideCaption = 'asideCaption' in meta ? meta.asideCaption : undefined;
/* Only render an image that actually exists, so a not-yet-added asset degrades
   to no image rather than a broken one. `public/` is served from the root. */
const hasAsset = (p?: string): boolean =>
  !!p && existsSync(new URL(`../../../public${p}`, import.meta.url));
const { Content } = await render(project);
const bundle = await projectBundle(slug);
const timeline = toTimeline(bundle);

const PROJECT_CYCLE: Product[] = ['windchime', 'lichtspiel', 'hrnsxtn'];
const otherSlug: Product = PROJECT_CYCLE[(PROJECT_CYCLE.indexOf(slug) + 1) % PROJECT_CYCLE.length];
const otherMeta = PROJECT_META[otherSlug];

const specRows = [
  { term: 'Role', value: d.role },
  { term: 'Timeframe', value: d.timeframe },
  { term: 'Audience', value: d.audience },
  {
    term: 'Collaborators',
    value: d.collaborators.length ? d.collaborators.join(', ') : 'Solo',
  },
  { term: 'Stack', values: d.tech },
];

let n = 0;
const idx = () => String(++n).padStart(2, '0');
---

<BaseLayout title={d.title} description={d.summary} accent={slug}>
  <article data-accent={slug}>
    <header class="phero">
      <div class="container">
        <a class="phero-back plain" href={url('/projects')}>← All projects</a>
        <div class="phero-cols">
          <div class="phero-main">
            <div class="phero-top">
              <span class="phero-kind">{meta?.kind}</span>
              <Badge tone={STATUS_TONE[d.status] ?? 'neutral'}>{lbl(d.status)}</Badge>
            </div>
            <div class="phero-idrow">
              {
                meta?.logo && (
                  <img class="phero-logo" src={url(meta.logo)} alt="" aria-hidden="true" />
                )
              }
              <h1 class="phero-title">{d.title}</h1>
            </div>
            <p class="phero-summary">{d.summary}</p>
            <div class="phero-thesis">
              <span class="label"><span class="idx">✳</span> Thesis</span>
              <p>{d.thesis}</p>
            </div>
            <div class="phero-credits">
              <span class="credit-context">{meta.credit}</span>
              <span class="credit-tools">
                {tools.map((t) => <span class="credit-chip">{t}</span>)}
              </span>
            </div>
          </div>
          {
            hasAsset(aside) && (
              <figure class="phero-aside">
                <img src={url(aside!)} alt={asideAlt} loading="lazy" />
                {asideCaption && <figcaption>{asideCaption}</figcaption>}
              </figure>
            )
          }
        </div>
        {
          'partners' in meta && (
            <div class="phero-partners" aria-label="Venues, events and affiliations">
              {meta.partners.map((p) => (
                <span
                  class:list={['partner-chip', { 'partner-dark': 'dark' in p && p.dark }]}
                  style={'scale' in p ? `--logo-scale: ${p.scale}` : undefined}
                >
                  <img src={url(p.img)} alt={p.alt} loading="lazy" />
                </span>
              ))}
            </div>
          )
        }
        {'partnersNote' in meta && <p class="phero-partners-note">{meta.partnersNote}</p>}
        {
          hasAsset(meta?.art) && (
            <figure class="phero-media">
              <img src={url(meta.art)} alt={meta.artAlt} loading="lazy" />
            </figure>
          )
        }
      </div>
    </header>

    <div class="container pbody">
      {
        demoVideoId && (
          <Section index={idx()} label="Demo" title="See it running" id="demo">
            <div class="video">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${demoVideoId}?rel=0`}
                title={demoVideoTitle}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              />
            </div>
          </Section>
        )
      }

      {/* Skim layer: visible by default. */}
      <Section index={idx()} label="At a glance" id="glance">
        <div class="glance">
          <SpecSheet rows={specRows} />
          <div class="glance-side">
            <div class="callout">
              <span class="label">The problem</span>
              <p>{d.problem}</p>
            </div>
          </div>
        </div>
        {
          d.constraints.length > 0 && (
            <Disclosure label="Constraints that shaped it" meta={String(d.constraints.length)}>
              <ul class="constraint-list">
                {d.constraints.map((c) => (
                  <li>{c}</li>
                ))}
              </ul>
            </Disclosure>
          )
        }
      </Section>

      {
        d.outcomes.length > 0 && (
          <Section index={idx()} label="Outcomes" title="What changed">
            <ul class="outcomes">
              {d.outcomes.map((o) => (
                <li>
                  <span class="outcome-mark" aria-hidden="true" />
                  {o}
                </li>
              ))}
            </ul>
          </Section>
        )
      }

      {
        venues && (
          <Section index={idx()} label={venues.label} title={venues.title} id="recognition">
            <div class="venues">
              {venues.venues.map((v) => (
                <div class="venue">
                  {v.logo && (
                    <span class="venue-logo">
                      <img src={url(v.logo.src)} alt={v.logo.alt} loading="lazy" />
                    </span>
                  )}
                  <p class="venue-name">{v.name}</p>
                  <p class="venue-place">{v.place}</p>
                  <p class="venue-detail">{v.detail}</p>
                  {v.paper && (
                    <>
                      <p class="venue-paper">“{v.paper.title}”</p>
                      <p class="venue-detail">{v.paper.summary}</p>
                    </>
                  )}
                  {v.link && (
                    <a class="venue-link plain" href={v.link.href}>
                      {v.link.label} <span aria-hidden="true">→</span>
                    </a>
                  )}
                </div>
              ))}
            </div>
          </Section>
        )
      }

      {
        gallery.program && (
          <Section index={idx()} label={gallery.program.label} title={gallery.program.title}>
            <div class="gallery gallery-program">
              {gallery.program.figures.map((f) => (
                <figure>
                  <img src={url(f.src)} alt={f.alt} loading="lazy" />
                  <figcaption>
                    {f.caption}
                    {f.link && <a href={f.link.href}>{f.link.label}</a>}
                    {f.link?.after}
                  </figcaption>
                </figure>
              ))}
            </div>
          </Section>
        )
      }

      {
        diagram && (
          <Section index={idx()} label="Architecture" title="How it fits together">
            <FlowDiagram
              stages={diagram.stages}
              outputs={diagram.outputs}
              caption={diagram.caption}
            />
          </Section>
        )
      }

      {
        slug === 'hrnsxtn' ? (
          <Section index={idx()} label="The hardware" title="Knobs before screens">
            <figure class="hw-board">
              <img
                src={url('/img/hs-board.png')}
                alt="The Elk Stomp development board: eight pots, four encoders, footswitches and an OLED on a dark ground"
                loading="lazy"
              />
              <figcaption>{HARDWARE[slug]}</figcaption>
            </figure>
          </Section>
        ) : (
          <Section index={idx()} label="The hardware" title="Tactile control, mirrored on screen">
            <MonomeTwin caption={HARDWARE[slug]} />
          </Section>
        )
      }

      {
        gallery.prototype && (
          <Section index={idx()} label={gallery.prototype.label} title={gallery.prototype.title}>
            {gallery.prototype.lead && <p class="gallery-lead">{gallery.prototype.lead}</p>}
            <div class="gallery">
              {gallery.prototype.figures.map((f) => (
                <figure>
                  <img src={url(f.src)} alt={f.alt} loading="lazy" />
                  <figcaption>{f.caption}</figcaption>
                </figure>
              ))}
            </div>
          </Section>
        )
      }

      {
        slug === 'windchime' && (
          <Section index={idx()} label="Under the hood" title="Retrieval in embedding space">
            <LatentMap />
          </Section>
        )
      }

      {/* Detail layer: one click away. */}
      <Section
        index={idx()}
        label="The story"
        title="How it came together"
        id="story"
        collapsible
        meta={readingTime(project.body)}
      >
        <div class="prose"><Content /></div>
      </Section>

      {
        bundle.milestones.length > 0 && (
          <Section
            index={idx()}
            label="Roadmap"
            title="Now, next, later"
            id="roadmap"
            collapsible
            count={bundle.milestones.length}
          >
            <Kanban milestones={bundle.milestones} />
          </Section>
        )
      }

      {
        timeline.length > 0 && (
          <Section
            index={idx()}
            label="Timeline"
            title="What happened, in order"
            id="timeline"
            collapsible
            count={timeline.length}
          >
            {/* Legacy section anchors: Releases, Incidents and Research now live in the Timeline. */}
            <span id="releases" />
            <span id="incidents" />
            <span id="research" />
            <Timeline events={timeline} />
          </Section>
        )
      }

      {
        bundle.decisions.length > 0 && (
          <Section
            index={idx()}
            label="Decisions"
            title="Decision records"
            id="decisions"
            collapsible
            count={bundle.decisions.length}
          >
            <div class="records">
              {bundle.decisions.map((rec) => (
                <details class="rec" id={`rec-${rec.id}`}>
                  <summary>
                    <Badge tone={STATUS_TONE[rec.data.status]}>{lbl(rec.data.status)}</Badge>
                    <span class="rec-title">{rec.data.title}</span>
                    <time class="rec-date">{fmtDay(rec.data.date)}</time>
                  </summary>
                  <div class="rec-body">
                    <p>
                      <strong>Context.</strong> {rec.data.context}
                    </p>
                    <p>
                      <strong>Decision.</strong> {rec.data.decision}
                    </p>
                    <p>
                      <strong>Why.</strong> {rec.data.rationale}
                    </p>
                    <p>
                      <strong>Consequences.</strong> {rec.data.consequences}
                    </p>
                  </div>
                </details>
              ))}
            </div>
          </Section>
        )
      }
    </div>

    <nav class="pnext" aria-label="Other project">
      <div class="container">
        <a class="pnext-link plain" href={url(`/projects/${otherSlug}`)} data-accent={otherSlug}>
          <span class="label">Next project →</span>
          <span class="pnext-name">{otherMeta?.label}</span>
          <span class="pnext-kind">{otherMeta?.kind}</span>
        </a>
      </div>
    </nav>
  </article>
</BaseLayout>

<style>
  .phero {
    padding-block: var(--sp-8) var(--sp-6);
    border-bottom: var(--hair) solid var(--hairline);
    background:
      radial-gradient(
        60% 120% at 88% -10%,
        color-mix(in oklab, var(--accent) 9%, transparent),
        transparent 70%
      ),
      var(--bg);
  }
  .phero-back {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--muted);
  }
  .phero-back:hover {
    color: var(--accent);
  }
  .phero-top {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-top: var(--sp-5);
  }
  .phero-kind {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
  }
  .phero-idrow {
    margin-top: var(--sp-3);
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }
  .phero-logo {
    width: clamp(3rem, 6vw, 4.4rem);
    height: clamp(3rem, 6vw, 4.4rem);
    object-fit: contain;
    flex-shrink: 0;
  }
  .phero-title {
    font-size: var(--step-6);
  }
  /* Hero: text column, with a secondary image pinned top-right on wide screens. */
  .phero-cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-6);
    align-items: start;
  }
  .phero-aside {
    margin: 0;
    justify-self: start;
    max-width: 26rem;
  }
  .phero-aside img {
    display: block;
    width: 100%;
    height: auto;
    border: var(--hair) solid var(--hairline);
    border-radius: var(--radius-lg);
    background: var(--surface-2);
  }
  .phero-aside figcaption {
    margin-top: var(--sp-2);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--faint);
  }
  @media (min-width: 60rem) {
    .phero-cols {
      grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
      gap: var(--sp-7);
    }
    .phero-aside {
      justify-self: end;
      margin-top: var(--sp-5);
    }
  }

  .phero-media {
    margin: var(--sp-6) 0 0;
    border: var(--hair) solid var(--hairline);
    border-radius: var(--radius-lg);
    overflow: hidden;
    max-width: 56rem;
    background: var(--surface-2);
  }
  /* Show the full frame: this is the project's signature image, so it is not
     cropped to a banner strip. */
  .phero-media img {
    display: block;
    width: 100%;
    height: auto;
  }
  .phero-summary {
    margin-top: var(--sp-4);
    max-width: 54ch;
    font-size: var(--step-1);
    color: var(--ink-soft);
  }
  .phero-thesis {
    margin-top: var(--sp-5);
    padding-left: var(--sp-4);
    border-left: 2px solid var(--accent);
    max-width: 60ch;
  }
  .phero-thesis p {
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 500;
    color: var(--ink);
    text-wrap: balance;
  }

  .phero-credits {
    margin-top: var(--sp-6);
    display: flex;
    align-items: center;
    gap: var(--sp-3) var(--sp-4);
    flex-wrap: wrap;
  }
  .credit-context {
    font-weight: 600;
    font-size: var(--step--1);
    color: var(--accent);
  }
  .credit-context::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--accent);
    margin-right: 0.5rem;
    vertical-align: middle;
  }
  .credit-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .credit-chip {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted);
    padding: 0.2rem 0.6rem;
    border: var(--hair) solid var(--hairline-strong);
    border-radius: 100px;
  }

  .pbody {
    padding-bottom: var(--sp-6);
  }

  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    max-width: 56rem;
    border: var(--hair) solid var(--hairline);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #000;
    box-shadow: var(--shadow);
  }
  .video iframe {
