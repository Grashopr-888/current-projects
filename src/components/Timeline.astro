---
import { fmtDate, fmtDay, isoDate } from '../lib/format';
import type { TimelineEvent } from '../lib/content';
import Badge from './Badge.astro';
import RecordBody from './RecordBody.astro';

interface Props {
  events: TimelineEvent[];
}
const { events } = Astro.props;
/* Day and month are enough within one year; a timeline spanning years shows the year too. */
const spansYears = new Set(events.map((e) => e.date.getUTCFullYear())).size > 1;
const label = (d: Date) => (spansYears ? fmtDate(d) : fmtDay(d));
---

<ol class="tl">
  {
    events.map((e) => (
      <li class="tl-item">
        <time class="tl-date" datetime={isoDate(e.date)} title={fmtDate(e.date)}>
          {label(e.date)}
        </time>
        {e.type === 'milestone' ? (
          <div class="tl-card" data-tone={e.tone ?? 'neutral'}>
            <span class="tl-kindrow">
              <span class="tl-node" aria-hidden="true" />
              <span class="tl-kind">{e.kind}</span>
            </span>{' '}
            <a class="tl-title tl-link plain" href={`#${e.anchor}`}>
              {e.title}
            </a>
          </div>
        ) : (
          <details class="tl-card tl-rec" id={e.anchor} data-tone={e.tone ?? 'neutral'}>
            <summary>
              <span class="tl-head">
                <span class="tl-kindrow">
                  <span class="tl-node" aria-hidden="true" />
                  <span class="tl-kind">{e.kind}</span>{' '}
                  {e.status && (
                    <Badge tone={e.statusTone ?? 'neutral'} dot={false}>
                      {e.status}
                    </Badge>
                  )}
                </span>{' '}
                <span class="tl-title">{e.title}</span>
              </span>
              <span class="tl-chevron" aria-hidden="true">
                +
              </span>
            </summary>
            <div class="tl-body">
              <RecordBody {...e} />
            </div>
          </details>
        )}
      </li>
    ))
  }
</ol>

<style>
  .tl {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }
  .tl-item {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: var(--sp-4);
    align-items: start;
  }
  .tl-date {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--ink);
    text-align: right;
    white-space: nowrap;
    padding-top: var(--sp-4);
  }

  .tl-card {
    --tone-c: var(--muted);
    position: relative;
    border: var(--hair) solid var(--hairline);
    border-left: 3px solid var(--tone-c);
    border-radius: var(--radius-lg);
    background: var(--surface);
    padding: var(--sp-4);
    min-width: 0;
  }
  .tl-card[data-tone='positive'] {
    --tone-c: var(--t-positive);
  }
  .tl-card[data-tone='warn'] {
    --tone-c: var(--t-warn);
  }
  .tl-card[data-tone='danger'] {
    --tone-c: var(--t-danger);
  }
  .tl-card[data-tone='info'] {
    --tone-c: var(--t-info);
  }

  /* Expandable record rows */
  .tl-rec {
    padding: 0;
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }
  .tl-rec:hover {
    border-color: color-mix(in oklab, var(--accent, var(--brand)) 50%, var(--hairline));
    border-left-color: var(--tone-c);
  }
  .tl-rec > summary {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-3);
    padding: var(--sp-4);
    cursor: pointer;
    list-style: none;
  }
  .tl-rec > summary::-webkit-details-marker {
    display: none;
  }
  .tl-rec[open] > summary {
    border-bottom: var(--hair) solid var(--hairline);
  }
  .tl-head {
    flex: 1;
    min-width: 0;
  }
  .tl-chevron {
    font-family: var(--font-mono);
    font-size: 1rem;
    line-height: 1.2;
    color: var(--accent, var(--brand));
    transition: transform 0.2s ease;
  }
  .tl-rec[open] .tl-chevron {
    transform: rotate(45deg);
  }
  .tl-body {
    padding: var(--sp-4);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    color: var(--ink-soft);
    font-size: var(--step--1);
    line-height: 1.6;
  }
  .tl-body :global(ul:not(.rb-chips)) {
    padding-left: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .tl-body :global(li)::marker {
    color: var(--accent, var(--brand));
  }

  .tl-kindrow {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .tl-node {
    width: 9px;
    height: 9px;
    border-radius: 100px;
    background: var(--tone-c);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--tone-c) 18%, transparent);
    flex-shrink: 0;
  }
  .tl-kind {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--tone-c);
  }
  .tl-title {
    display: block;
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    line-height: 1.2;
    color: var(--ink);
  }
  .tl-link:hover {
    color: var(--accent, var(--brand));
  }

  @media (max-width: 560px) {
    .tl-item {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
    .tl-date {
      text-align: left;
      padding-top: 0;
    }
  }
</style>
