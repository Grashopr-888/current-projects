---
/** The project page hero, shared by projects/[slug].astro and the research pages
 *  (projects/groove/). Identity, credit line and venue marks come from PROJECT_META;
 *  the default slot adds anything a page needs under the credits (for example links). */
import { PROJECT_META, type ProjectSlug } from '../config';
import { url } from '../lib/url';
import { existsSync } from 'node:fs';

/** One button per publication link. A link with no href yet renders as a pending pill
 *  that says when it arrives (`pending`). */
export type PubLink = { label: string; href?: string; primary?: boolean; pending?: string };
export type Pubs = { label: string; links: PubLink[] };

interface Props {
  slug: ProjectSlug;
  title: string;
  summary: string;
  /** Label over the highlighted statement ("Thesis" on product pages). */
  thesisLabel?: string;
  thesis: string;
  tools: string[];
  /** Publication links, shown right under the thesis. */
  pubs?: Pubs;
}
const { slug, title, summary, thesisLabel = 'Thesis', thesis, tools, pubs } = Astro.props;
const external = (href: string): boolean => /^https?:/.test(href);
/* A GitHub link carries the GitHub mark (Octicons mark-github, MIT). */
const isGithub = (href: string): boolean => /^https:\/\/github\.com\//.test(href);
const GITHUB_MARK =
  'M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z';
const meta = PROJECT_META[slug];

/* A secondary hero image (top right), where a project defines one. */
const aside = 'aside' in meta ? meta.aside : undefined;
const asideAlt = 'asideAlt' in meta ? meta.asideAlt : '';
const asideCaption = 'asideCaption' in meta ? meta.asideCaption : undefined;
/* Only render an image that actually exists, so a not-yet-added asset degrades
   to no image rather than a broken one. `public/` is served from the root. */
const hasAsset = (p?: string): boolean =>
  !!p && existsSync(new URL(`../../public${p}`, import.meta.url));

/* The venue band: the conference's own imagery tiled behind the logo strip. */
const band = 'venueBand' in meta ? meta.venueBand : undefined;
const bandImages = band ? band.images.filter((im) => hasAsset(im.src)) : [];
---

<header class="phero" data-contour>
  <div class="container">
    <a class="phero-back plain" href={url('/projects')}>← All projects</a>
    <div class="phero-cols">
      <div class="phero-main" data-contour-clear>
        <div class="phero-top">
          <span class="phero-kind">{meta.kind}</span>
        </div>
        <div class="phero-idrow">
          {meta.logo && <img class="phero-logo" src={url(meta.logo)} alt="" aria-hidden="true" />}
          <h1 class="phero-title">{title}</h1>
        </div>
        <p class="phero-summary">{summary}</p>
        <div class="phero-thesis">
          <span class="label"><span class="idx">✳</span> {thesisLabel}</span>
          <p>{thesis}</p>
        </div>
        {
          pubs && (
            <div class="phero-pubs">
              <span class="label phero-pubs-label">{pubs.label}</span>
              <div class="phero-pub-row">
                {pubs.links.map((l) =>
                  l.href ? (
                    <a
                      class:list={['btn', 'phero-pub', { 'phero-pub-primary': l.primary }]}
                      href={l.href}
                      rel={external(l.href) ? 'noopener' : undefined}
                    >
                      {isGithub(l.href) && (
                        <svg
                          class="phero-pub-icon"
                          viewBox="0 0 16 16"
                          width="16"
                          height="16"
                          aria-hidden="true"
                        >
                          <path fill="currentColor" d={GITHUB_MARK} />
                        </svg>
                      )}
                      {l.label}
                      {external(l.href) && <span aria-hidden="true">↗</span>}
                    </a>
                  ) : (
                    <span class="btn phero-pub phero-pub-pending" aria-disabled="true">
                      {l.label}
                      {l.pending && <span class="phero-pub-when">{l.pending}</span>}
                    </span>
                  )
                )}
              </div>
            </div>
          )
        }
        <div class="phero-credits">
          <span class="credit-context">{meta.credit}</span>
          <span class="credit-tools">
            {tools.map((t) => <span class="credit-chip">{t}</span>)}
          </span>
        </div>
        <slot />
      </div>
      {
        hasAsset(aside) && (
          <figure class="phero-aside">
            <img src={url(aside!)} alt={asideAlt} loading="lazy" />
            {asideCaption && <figcaption>{asideCaption}</figcaption>}
          </figure>
        )
      }
    </div>
    {
      'partners' in meta && (
        <div
          class:list={['phero-band', { 'phero-band-on': bandImages.length > 0 }]}
          style={`--tiles: ${Math.max(bandImages.length, 1)}`}
        >
          {bandImages.length > 0 && (
            <div class="phero-band-tiles">
              {bandImages.map((im) => (
                <img
                  src={url(im.src)}
                  alt={im.alt}
                  loading="lazy"
                  style={'focus' in im ? `object-position: ${im.focus}` : undefined}
                />
              ))}
            </div>
          )}
          {band && bandImages.length > 0 && <p class="phero-band-label">{band.label}</p>}
          <div class="phero-partners" aria-label="Venues, events and affiliations">
            {meta.partners.map((p) => (
              <span
                class:list={['partner-chip', { 'partner-dark': 'dark' in p && p.dark }]}
                style={'scale' in p ? `--logo-scale: ${p.scale}` : undefined}
              >
                <img src={url(p.img)} alt={p.alt} loading="lazy" />
              </span>
            ))}
          </div>
          {band && bandImages.length > 0 && <p class="phero-band-credit">{band.credit}</p>}
        </div>
      )
    }
    {'partnersNote' in meta && <p class="phero-partners-note">{meta.partnersNote}</p>}
    {
      hasAsset(meta.art) && (
        <figure class="phero-media">
          <img src={url(meta.art)} alt={meta.artAlt} loading="lazy" />
        </figure>
      )
    }
  </div>
</header>

<style>
  .phero {
    padding-block: var(--sp-8) var(--sp-6);
    border-bottom: var(--hair) solid var(--hairline);
    background:
      radial-gradient(
        60% 120% at 88% -10%,
        color-mix(in oklab, var(--accent) 9%, transparent),
        transparent 70%
      ),
      var(--bg);
  }
  .phero-back {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--muted);
  }
  .phero-back:hover {
    color: var(--accent);
  }
  .phero-top {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-top: var(--sp-5);
  }
  .phero-kind {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
  }
  .phero-idrow {
    margin-top: var(--sp-3);
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }
  .phero-logo {
    width: clamp(3rem, 6vw, 4.4rem);
    height: clamp(3rem, 6vw, 4.4rem);
    object-fit: contain;
    flex-shrink: 0;
  }
  .phero-title {
    font-size: var(--step-6);
  }
  /* Hero: text column, with a secondary image pinned top-right on wide screens. */
  .phero-cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-6);
    align-items: start;
  }
  .phero-aside {
    margin: 0;
    justify-self: start;
    max-width: 26rem;
  }
  .phero-aside img {
    display: block;
    width: 100%;
    height: auto;
    border: var(--hair) solid var(--hairline);
    border-radius: var(--radius-lg);
    background: var(--surface-2);
  }
  .phero-aside figcaption {
    margin-top: var(--sp-2);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--faint);
  }
  @media (min-width: 60rem) {
    .phero-cols {
      grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
      gap: var(--sp-7);
    }
    .phero-aside {
      justify-self: end;
      margin-top: var(--sp-5);
    }
  }

  .phero-media {
    margin: var(--sp-6) 0 0;
    border: var(--hair) solid var(--hairline);
    border-radius: var(--radius-lg);
    overflow: hidden;
    max-width: 56rem;
    background: var(--surface-2);
  }
  /* Show the full frame: this is the project's signature image, so it is not
     cropped to a banner strip. */
  .phero-media img {
    display: block;
    width: 100%;
    height: auto;
  }
  .phero-summary {
    margin-top: var(--sp-4);
    max-width: 54ch;
    font-size: var(--step-1);
    color: var(--ink-soft);
  }
  .phero-thesis {
    margin-top: var(--sp-5);
    padding-left: var(--sp-4);
    border-left: 2px solid var(--accent);
    max-width: 60ch;
  }
  .phero-thesis p {
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 500;
    color: var(--ink);
    text-wrap: balance;
  }

  /* Publication buttons, under the thesis: the primary link in the project color. */
  .phero-pubs {
    margin-top: var(--sp-5);
  }
  .phero-pubs-label {
    color: var(--accent);
  }
  .phero-pub-row {
    margin-top: var(--sp-3);
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }
  .phero-pub-icon {
    width: 1.05em;
    height: 1.05em;
    flex: none;
  }
  .phero-pub-primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #0d0d10;
  }
  .phero-pub-primary:hover {
    border-color: var(--accent);
    box-shadow: 0 10px 26px -12px color-mix(in oklab, var(--accent) 80%, transparent);
  }
  .phero-pub-pending {
    cursor: default;
    color: var(--muted);
    border-style: dashed;
  }
  .phero-pub-pending:hover {
    transform: none;
    border-color: var(--hairline-strong);
  }
  .phero-pub-when {
    font-family: var(--font-mono);
    font-weight: 400;
    font-stretch: 100%;
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.72rem;
    color: var(--faint);
  }

  .phero-credits {
    margin-top: var(--sp-6);
    display: flex;
    align-items: center;
    gap: var(--sp-3) var(--sp-4);
    flex-wrap: wrap;
  }
  .credit-context {
    font-weight: 600;
    font-size: var(--step--1);
    color: var(--accent);
  }
  .credit-context::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--accent);
    margin-right: 0.5rem;
    vertical-align: middle;
  }
  .credit-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .credit-chip {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted);
    padding: 0.2rem 0.6rem;
    border: var(--hair) solid var(--hairline-strong);
    border-radius: 100px;
  }

  /* Venue band: the conference's photos tiled behind the logos, under a dark scrim so the
     marks stay legible. Without images it is a plain wrapper and the strip looks as before. */
  .phero-band-on {
    position: relative;
    isolation: isolate;
    margin-top: 1.6rem;
    min-height: 13rem;
    padding: var(--sp-4) var(--sp-5) var(--sp-5);
    display: flex;
    flex-direction: column;
    border: var(--hair) solid var(--hairline);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #0d0d10;
  }
  .phero-band-tiles {
    position: absolute;
    inset: 0;
    z-index: -2;
    display: grid;
    grid-template-columns: repeat(var(--tiles), minmax(0, 1fr));
    /* One row exactly the band's height, so each photo crops around its focal point. */
    grid-template-rows: minmax(0, 1fr);
    gap: 3px;
    background: #0d0d10;
  }
  .phero-band-tiles img {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
    display: block;
  }
  /* Scrim: darker on the left where the label sits, lighter toward the photos' right edge. */
  .phero-band-on::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        180deg,
        rgba(10, 10, 14, 0.66) 0%,
        rgba(10, 10, 14, 0.18) 40%,
        rgba(10, 10, 14, 0.18) 70%,
        rgba(10, 10, 14, 0.7) 100%
      ),
      linear-gradient(90deg, rgba(10, 10, 14, 0.3), rgba(10, 10, 14, 0) 60%);
  }
  .phero-band-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #fff;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.7);
  }
  .phero-band-on .phero-partners {
    margin-top: var(--sp-4);
  }
  .phero-band-on .partner-chip {
    box-shadow: 0 6px 22px -8px rgba(0, 0, 0, 0.6);
  }
  .phero-band-credit {
    margin-top: auto;
    padding-top: var(--sp-4);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: rgba(255, 255, 255, 0.72);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.8);
  }
  @media (max-width: 720px) {
    .phero-band-on {
      padding: var(--sp-3) var(--sp-3) var(--sp-4);
    }
    /* Stack the photos on phones so each stays recognizable. */
    .phero-band-tiles {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: repeat(var(--tiles), minmax(0, 1fr));
    }
  }

  /* Partner marks in the hero: attribution strip, not decoration. */
  .phero-partners {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.6rem;
    flex-wrap: wrap;
  }
  .phero-partners-note {
    margin-top: var(--sp-3);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: color-mix(in oklab, var(--accent) 75%, var(--muted));
  }
  .partner-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 5.4rem;
    padding: 0.65rem 1.1rem;
    border: var(--hair) solid var(--hairline);
    border-radius: 12px;
    background: #fff;
    flex: none;
  }
  /* Per-logo height within the tile comes from PROJECT_META partners[].scale. */
  .partner-chip img {
    height: calc(100% * var(--logo-scale, 1));
    width: auto;
    max-width: 27rem;
    object-fit: contain;
    display: block;
  }
  .partner-chip.partner-dark {
    background: #161a1d;
  }
  @media (max-width: 720px) {
    .partner-chip {
      height: 3.4rem;
      padding: 0.45rem 0.8rem;
    }
  }
</style>
