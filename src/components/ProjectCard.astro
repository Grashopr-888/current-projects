---
/**
 * Project card, images first: the art, the mark and title, and the venue and host marks are
 * visible; the credit line, summary, languages, core skills and timeframe wait behind Details.
 * Image and title link to the project page, as does Explore.
 */
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/url';
import { PROJECT_META } from '../config';
import { existsSync } from 'node:fs';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Home card: Details leaves out the summary paragraph. */
  compact?: boolean;
}
const { project, compact = false } = Astro.props;
const d = project.data;
const slug = project.id;
const meta = PROJECT_META[slug as keyof typeof PROJECT_META];
const href = url(`/projects/${slug}`);

/* Use the project's main art, falling back to its secondary image while an
   asset is still missing, so the card never renders a broken image. */
const has = (p?: string): boolean =>
  !!p && existsSync(new URL(`../../public${p}`, import.meta.url));
const asideArt = 'aside' in meta ? meta.aside : undefined;
const asideArtAlt = 'asideAlt' in meta ? meta.asideAlt : '';
const cardArt = has(meta?.art) ? meta.art : has(asideArt) ? asideArt : undefined;
const cardAlt = has(meta?.art) ? meta.artAlt : asideArtAlt;
const partners = 'partners' in meta ? meta.partners : [];
---

<article class="pcard card" data-accent={slug}>
  <span class="pcard-spine" aria-hidden="true"></span>
  {
    cardArt && (
      <a class="pcard-media plain" href={href} tabindex="-1" aria-hidden="true">
        <img src={url(cardArt)} alt={cardAlt} loading="lazy" />
      </a>
    )
  }
  <span class="pcard-kind">{meta?.kind ?? d.role}</span>
  <a class="pcard-idrow plain" href={href}>
    {meta?.logo && <img class="pcard-logo" src={url(meta.logo)} alt="" aria-hidden="true" />}
    <h3 class="pcard-title">{d.title}</h3>
  </a>
  {
    partners.length > 0 && (
      <div class="pcard-partners" aria-label="Venues, events and affiliations">
        {partners.map((p) => (
          <span
            class:list={['pcard-partner', { 'pcard-partner-dark': 'dark' in p && p.dark }]}
            style={'scale' in p ? `--logo-scale: ${p.scale}` : undefined}
          >
            <img src={url(p.img)} alt={p.alt} loading="lazy" />
          </span>
        ))}
      </div>
    )
  }
  <div class="pcard-foot">
    <details class="pcard-more">
      <summary class="pcard-more-toggle">
        <span class="pcard-more-icon" aria-hidden="true">+</span> Details
      </summary>
      <div class="pcard-more-body">
        {
          'credit' in meta && (
            <p class="pcard-credit">
              {meta.credit}
              {'partnersNote' in meta && <span class="pcard-credit-note">{meta.partnersNote}</span>}
            </p>
          )
        }
        {!compact && <p class="pcard-summary">{d.summary}</p>}
        {
          d.languages.length > 0 && (
            <div class="pcard-langs">
              <span class="pcard-langs-label">Languages</span>
              <span class="cluster">
                {d.languages.map((t) => (
                  <span class="chip">{t}</span>
                ))}
              </span>
            </div>
          )
        }
        {
          d.skills.length > 0 && (
            <div class="pcard-langs">
              <span class="pcard-langs-label">Core skills</span>
              <span class="cluster">
                {d.skills.map((t) => (
                  <span class="chip" data-product={slug}>
                    {t}
                  </span>
                ))}
              </span>
            </div>
          )
        }
        <span class="pcard-tf">{d.timeframe}</span>
      </div>
    </details>
    <a class="pcard-go plain" href={href}>Explore <span class="arrow">→</span></a>
  </div>
</article>

<style>
  .pcard {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    padding: var(--sp-5);
    padding-left: calc(var(--sp-5) + 3px);
    overflow: hidden;
    transition:
      box-shadow 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }
  .pcard:hover {
    box-shadow: var(--shadow);
    border-color: color-mix(in oklab, var(--accent) 45%, var(--hairline));
    background: color-mix(in oklab, var(--accent) 4%, var(--surface));
  }
  .pcard-spine {
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--accent);
    opacity: 0.85;
    z-index: 1;
  }
  .pcard-media {
    display: block;
    margin: calc(var(--sp-5) * -1) calc(var(--sp-5) * -1) 0 calc(var(--sp-5) * -1 - 3px);
    aspect-ratio: 16 / 8;
    overflow: hidden;
    border-bottom: var(--hair) solid var(--hairline);
    background: var(--surface-2);
  }
  .pcard-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .pcard:hover .pcard-media img {
    transform: scale(1.025);
  }
  .pcard-kind {
    margin-top: var(--sp-2);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .pcard-idrow {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }
  .pcard-idrow:hover .pcard-title {
    color: var(--accent);
  }
  .pcard-logo {
    width: 2.2rem;
    height: 2.2rem;
    object-fit: contain;
    flex-shrink: 0;
  }
  .pcard-title {
    font-size: var(--step-3);
    text-transform: uppercase;
    font-stretch: var(--display-stretch);
    transition: color 0.15s ease;
  }

  /* Venue and host marks: the card's second image row, sized to be read. */
  .pcard-partners {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }
  .pcard-partner {
    display: inline-flex;
    align-items: center;
    height: 4.6rem;
    padding: 0.6rem 0.95rem;
    border-radius: 10px;
    background: #fff;
    border: var(--hair) solid var(--hairline);
  }
  .pcard-partner-dark {
    background: #161a1d;
  }
  .pcard-partner img {
    height: calc(100% * var(--logo-scale, 1));
    width: auto;
    max-width: 16rem;
    object-fit: contain;
    display: block;
  }
  @media (max-width: 560px) {
    .pcard-partner {
      height: 3.6rem;
      padding: 0.45rem 0.7rem;
    }
  }

  /* Details, collapsed by default, beside the Explore link. */
  .pcard-foot {
    margin-top: auto;
    padding-top: var(--sp-4);
    border-top: var(--hair) solid var(--hairline);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--sp-3);
  }
  .pcard-more-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--muted);
    transition: color 0.15s ease;
  }
  .pcard-more-toggle::-webkit-details-marker {
    display: none;
  }
  .pcard-more-toggle:hover {
    color: var(--ink);
  }
  .pcard-more-icon {
    font-size: 1rem;
    line-height: 1;
    color: var(--accent);
    transition: transform 0.2s ease;
  }
  .pcard-more[open] .pcard-more-icon {
    transform: rotate(45deg);
  }
  .pcard-more-body {
    margin-top: var(--sp-4);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }
  .pcard-credit {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-weight: 600;
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--accent);
  }
  .pcard-credit-note {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.7rem;
    color: color-mix(in oklab, var(--accent) 75%, var(--muted));
  }
  .pcard-summary {
    color: var(--muted);
    font-size: var(--step--1);
    line-height: 1.55;
    max-width: 52ch;
  }
  .pcard-langs {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .pcard-langs-label {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--faint);
  }
  .pcard-tf {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--muted);
  }
  .pcard-go {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--accent);
    white-space: nowrap;
  }
  .arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }
  .pcard-go:hover .arrow {
    transform: translateX(3px);
  }
</style>
