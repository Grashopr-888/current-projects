---
/** A citation with its BibTeX and a copy button. Text is verbatim. */
interface Props {
  label: string;
  citation: string;
  bibtex: string;
}
const { label, citation, bibtex } = Astro.props;
---

<div class="cite">
  <div class="cite-head">
    <span class="cite-label">{label}</span>
    <button class="cite-copy" type="button" data-bibtex={bibtex}>Copy BibTeX</button>
  </div>
  <p class="cite-text">{citation}</p>
  <pre class="cite-code"><code>{bibtex}</code></pre>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.cite-copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.bibtex ?? '';
      const prev = btn.textContent;
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = 'Copied ✓';
      } catch {
        btn.textContent = 'Copy failed';
      }
      setTimeout(() => (btn.textContent = prev), 1600);
    });
  });
</script>

<style>
  .cite {
    border: var(--hair) solid var(--hairline);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
  }
  .cite-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    padding: var(--sp-3) var(--sp-4);
    border-bottom: var(--hair) solid var(--hairline);
    background: var(--surface-2);
  }
  .cite-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .cite-copy {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    border: var(--hair) solid var(--hairline-strong);
    border-radius: 100px;
    padding: 0.25rem 0.75rem;
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .cite-copy:hover {
    border-color: var(--accent);
  }
  .cite-text {
    padding: var(--sp-4);
    font-size: var(--step--1);
    color: var(--ink-soft);
    line-height: 1.6;
  }
  .cite-code {
    margin: 0;
    padding: var(--sp-4);
    border-top: var(--hair) solid var(--hairline);
    overflow-x: auto;
    font-size: 0.74rem;
    line-height: 1.55;
    color: var(--muted);
    background: var(--bg);
    white-space: pre;
  }
</style>
