---
/** Interactive t-SNE of the saved embeddings (public/groove/data/embeddings-*.json).
 *  Plotly loads only when the reader asks for it. */
import { gasset } from '../../lib/groove';
---

<div class="emb" id="emb-explorer" data-src={gasset('/data/')}>
  <div class="emb-bar">
    <div class="emb-models" role="group" aria-label="Model">
      <button type="button" class="emb-model is-on" data-model="passt" aria-pressed="true"
        >PaSST</button
      >
      <button type="button" class="emb-model" data-model="cnn" aria-pressed="false">CNN</button>
    </div>
    <label class="emb-perp">
      <span>Perplexity <strong id="emb-perp-val">30</strong></span>
      <input
        type="range"
        id="emb-perp"
        min="0"
        max="6"
        step="1"
        value="2"
        aria-label="t-SNE perplexity"
      />
    </label>
    <button type="button" class="emb-reset" id="emb-reset" hidden>Reset zoom</button>
  </div>

  <div class="emb-stage">
    <div
      id="emb-plot"
      class="emb-plot"
      role="img"
      aria-label="Interactive t-SNE scatter of model embeddings, coloured by primary drum style."
    >
    </div>
    <button type="button" class="emb-load" id="emb-load">
      <span class="emb-load-play" aria-hidden="true">▶</span>
      Load the interactive embeddings
      <span class="emb-load-note">Plotly · ~0.3&nbsp;MB · 1,827 points</span>
    </button>
  </div>

  <p class="emb-hint">
    Drag to zoom, double click to reset, click a style in the legend to hide it. Move the slider to
    reproject the same embeddings at a different t-SNE perplexity.
  </p>
</div>

<script>
  const root = document.getElementById('emb-explorer');
  if (root) {
    const SRC = root.dataset.src || '';
    const PERPS = [5, 15, 30, 40, 50, 75, 100];
    const cache: Record<string, any> = {};
    let model = 'passt';
    let k = 2;
    let loaded = false;

    const plotEl = document.getElementById('emb-plot') as HTMLElement;
    const perpVal = document.getElementById('emb-perp-val')!;
    const resetBtn = document.getElementById('emb-reset') as HTMLButtonElement;

    function loadPlotly(): Promise<void> {
      if ((window as any).Plotly) return Promise.resolve();
      return new Promise((res, rej) => {
        const s = document.createElement('script');
        s.src = 'https://cdn.plot.ly/plotly-2.35.2.min.js';
        s.onload = () => res();
        s.onerror = () => rej(new Error('Plotly failed to load'));
        document.head.appendChild(s);
      });
    }
    async function getData(m: string) {
      if (cache[m]) return cache[m];
      const r = await fetch(`${SRC}embeddings-${m}.json`);
      cache[m] = await r.json();
      return cache[m];
    }
    function buildTraces(d: any, ki: number) {
      const groups: Record<string, { x: number[]; y: number[]; cd: any[] }> = {};
      for (const pt of d.points) {
        const xy = pt.xy[ki];
        if (!xy) continue;
        groups[pt.p] ||= { x: [], y: [], cd: [] };
        groups[pt.p].x.push(xy[0]);
        groups[pt.p].y.push(xy[1]);
        groups[pt.p].cd.push([pt.p, pt.s || '(none)', pt.f]);
      }
      return Object.keys(groups)
        .sort()
        .map((name) => ({
          type: 'scattergl',
          mode: 'markers',
          name,
          x: groups[name].x,
          y: groups[name].y,
          customdata: groups[name].cd,
          marker: { size: 5, color: d.colorMap[name] || '#888', opacity: 0.9, line: { width: 0 } },
          hovertemplate:
            '<b>%{customdata[2]}</b><br>primary: %{customdata[0]}<br>secondary: %{customdata[1]}<extra></extra>',
        }));
    }
    function layout() {
      const css = getComputedStyle(document.documentElement);
      const ink = css.getPropertyValue('--ink-soft').trim() || '#e5e5e8';
      const grid = css.getPropertyValue('--hairline').trim() || '#2b2c30';
      return {
        title: {
          text: `${model === 'cnn' ? 'CNN' : 'PaSST'} embeddings · t-SNE (perplexity ${PERPS[k]})`,
          font: { size: 15 },
        },
        height: 560,
        margin: { l: 36, r: 8, t: 40, b: 36 },
        xaxis: { zeroline: false, showgrid: false, title: 't-SNE 1', linecolor: grid },
        yaxis: { zeroline: false, showgrid: false, title: 't-SNE 2', linecolor: grid },
        legend: { font: { size: 10 }, itemsizing: 'constant' },
        paper_bgcolor: 'rgba(0,0,0,0)',
        // A light plot panel: the dataset's own style colours include near blacks.
        plot_bgcolor: '#f4f4f6',
        font: { color: ink, family: 'Inter Variable, system-ui, sans-serif' },
        hoverlabel: { font: { family: 'IBM Plex Mono, monospace' } },
      };
    }
    async function render() {
      const d = await getData(model);
      const Plotly = (window as any).Plotly;
      Plotly.react(plotEl, buildTraces(d, k), layout(), {
        responsive: true,
        displaylogo: false,
        modeBarButtonsToRemove: ['lasso2d', 'select2d'],
      });
      resetBtn.hidden = false;
    }
    async function activate() {
      if (loaded) return;
      const btn = document.getElementById('emb-load') as HTMLButtonElement;
      btn.textContent = 'Loading…';
      try {
        await loadPlotly();
        loaded = true;
        btn.remove();
        await render();
      } catch {
        btn.textContent = 'Could not load Plotly (offline?)';
      }
    }

    document.getElementById('emb-load')!.addEventListener('click', activate);
    document.querySelectorAll<HTMLButtonElement>('.emb-model').forEach((b) =>
      b.addEventListener('click', async () => {
        document.querySelectorAll('.emb-model').forEach((x) => {
          x.classList.remove('is-on');
          x.setAttribute('aria-pressed', 'false');
        });
        b.classList.add('is-on');
        b.setAttribute('aria-pressed', 'true');
        model = b.dataset.model!;
        if (loaded) await render();
      })
    );
    document.getElementById('emb-perp')!.addEventListener('input', async (e) => {
      k = +(e.target as HTMLInputElement).value;
      perpVal.textContent = String(PERPS[k]);
      if (loaded) await render();
    });
    resetBtn.addEventListener('click', () =>
      (window as any).Plotly?.relayout(plotEl, { 'xaxis.autorange': true, 'yaxis.autorange': true })
    );
  }
</script>

<style>
  .emb {
    padding: var(--sp-4);
    border: var(--hair) solid var(--hairline);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .emb-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-4);
    margin-bottom: var(--sp-3);
  }
  .emb-models {
    display: inline-flex;
    border: var(--hair) solid var(--hairline-strong);
    border-radius: 100px;
    overflow: hidden;
  }
  .emb-model {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.4rem 1rem;
    background: var(--surface);
    color: var(--muted);
    border: none;
    cursor: pointer;
  }
  .emb-model.is-on {
    background: var(--accent);
    color: #121214;
    font-weight: 500;
  }
  .emb-perp {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .emb-perp input {
    width: clamp(120px, 22vw, 220px);
    accent-color: var(--accent);
  }
  .emb-perp strong {
    font-family: var(--font-mono);
    color: var(--accent);
  }
  .emb-reset {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    background: none;
    border: var(--hair) solid var(--hairline-strong);
    border-radius: 100px;
    padding: 0.25rem 0.75rem;
    cursor: pointer;
    color: var(--ink-soft);
  }
  .emb-stage {
    position: relative;
    min-height: 560px;
  }
  .emb-plot {
    width: 100%;
    min-height: 560px;
  }
  .emb-load {
    position: absolute;
    inset: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    background:
      radial-gradient(
        60% 60% at 50% 40%,
        color-mix(in oklab, var(--accent) 8%, transparent),
        transparent
      ),
      var(--bg);
    border: 1px dashed var(--hairline-strong);
    border-radius: var(--radius);
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 740;
    font-stretch: 112%;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: var(--step-0);
    color: var(--ink);
  }
  .emb-load:hover {
    border-color: var(--accent);
  }
  .emb-load-play {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--accent);
    color: #121214;
    font-size: 1.1rem;
  }
  .emb-load-note {
    font-family: var(--font-mono);
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.72rem;
    color: var(--muted);
  }
  .emb-hint {
    margin-top: var(--sp-3);
    font-size: var(--step--1);
    color: var(--muted);
  }
</style>
